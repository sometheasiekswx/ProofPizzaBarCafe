  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "menu:sync": "node --env-file-if-exists=.env.local scripts/sync-menu.mjs",
    "build": "npm run menu:sync && next build",
